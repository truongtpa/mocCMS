# ---------------------------------------------------------------------------
# Image "local" dùng để build JS (Vue 3 + Vite) bằng Docker trên máy dev / CI.
# Không mount source từ host -> build sạch, không phụ thuộc node_modules máy.
#
# Dùng qua: ./build-assets.sh   (script sẽ docker cp kết quả ra public/)
# Không liên quan nơi chạy — chỉ tạo ra JS cho image base ở docker/Dockerfile.
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim AS assets

ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git \
        python3 \
        make \
        g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) Cài node_modules trước để tận dụng layer cache
COPY package.json package-lock.json ./
RUN npm ci

# 2) Ziggy được import trong resources/js/main.js qua alias
#    'ziggy-js' -> vendor/tightenco/ziggy (xem vite.config.js)
COPY vendor/tightenco/ziggy ./vendor/tightenco/ziggy

# 3) Source + config build
COPY vite.config.js postcss.config.js tailwind.config.js ./
COPY resources ./resources
COPY public ./public

# 4) File .env chỉ để Vite đọc các biến VITE_* lúc build.
#    Truyền qua ARG ENV_FILE (mặc định .env) trong build-assets.sh
ARG ENV_FILE=.env
COPY ${ENV_FILE} ./.env

# public/hot làm Laravel trỏ asset về vite dev server -> phải bỏ
RUN rm -f public/hot

RUN npm run build

# Kết quả:
#   /app/public/asset/admin/build   (buildDirectory trong vite.config.js)
