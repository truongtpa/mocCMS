FROM node:22-bookworm-slim AS assets

ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.js ./
COPY resources ./resources
COPY public ./public

ARG ENV_FILE=.env
COPY ${ENV_FILE} ./.env

RUN rm -f public/hot
RUN npm run build
