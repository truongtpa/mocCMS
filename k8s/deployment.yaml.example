# Cùng 1 image, khác CONTAINER_ROLE:
#   app    -> FrankenPHP/Octane phục vụ HTTP
#   worker -> queue:work + schedule:work
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hoso-sinhvien
  namespace: vlute-hoso-sinhvien
spec:
  replicas: 2
  selector:
    matchLabels:
      app: hoso-sinhvien
  template:
    metadata:
      labels:
        app: hoso-sinhvien
    spec:
      containers:
        - name: app
          image: 172.20.6.10:32000/hoso-sinhvien:latest
          imagePullPolicy: Always
          env:
            - name: CONTAINER_ROLE
              value: "app"
          envFrom:
            - configMapRef:
                name: hoso-sinhvien-config
          ports:
            - containerPort: 8000
          readinessProbe:
            httpGet:
              path: /up
              port: 8000
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /up
              port: 8000
            initialDelaySeconds: 30
            periodSeconds: 20
          resources:
            requests:
              cpu: "250m"
              memory: "512Mi"
            limits:
              cpu: "2"
              memory: "1Gi"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hoso-sinhvien-worker
  namespace: vlute-hoso-sinhvien
spec:
  # Scheduler chạy trong pod này -> giữ đúng 1 replica để job không chạy trùng.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: hoso-sinhvien-worker
  template:
    metadata:
      labels:
        app: hoso-sinhvien-worker
    spec:
      terminationGracePeriodSeconds: 650
      containers:
        - name: worker
          image: 172.20.6.10:32000/hoso-sinhvien:latest
          imagePullPolicy: Always
          env:
            - name: CONTAINER_ROLE
              value: "worker"
          envFrom:
            - configMapRef:
                name: hoso-sinhvien-config
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "1"
              memory: "768Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: hoso-sinhvien
  namespace: vlute-hoso-sinhvien
spec:
  selector:
    app: hoso-sinhvien
  ports:
    - port: 80
      targetPort: 8000
