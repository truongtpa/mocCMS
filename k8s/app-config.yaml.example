# kubectl apply -f k8s/app-config.yaml
# Các biến ở đây override .env đã nướng sẵn trong image (envFrom -> configMapRef).
apiVersion: v1
kind: ConfigMap
metadata:
  name: hoso-sinhvien-config
  namespace: vlute-hoso-sinhvien
data:
  APP_NAME: "Hồ sơ sinh viên"
  APP_ENV: "production"
  APP_KEY: "base64:CHANGE_ME"
  APP_DEBUG: "false"
  APP_TIMEZONE: "UTC"
  APP_URL: "https://hoso-sinhvien.vlute.edu.vn"

  LOG_CHANNEL: "stderr"
  LOG_STACK: "single"
  LOG_DEPRECATIONS_CHANNEL: "null"
  LOG_LEVEL: "info"

  DB_CONNECTION: "mysql"
  DB_HOST: "CHANGE_ME"
  DB_PORT: "3306"
  DB_DATABASE: "hoso_sinhvien"
  DB_USERNAME: "web"
  DB_PASSWORD: "CHANGE_ME"

  SESSION_DRIVER: "file"
  SESSION_LIFETIME: "120"
  CACHE_STORE: "file"
  FILESYSTEM_DISK: "s3"
  BROADCAST_CONNECTION: "log"
  QUEUE_CONNECTION: "database"

  # S3 / MinIO
  AWS_ACCESS_KEY_ID: "CHANGE_ME"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME"
  AWS_DEFAULT_REGION: "us-east-1"
  AWS_BUCKET: "hoso-sinhvien-vlute-edu-vn"
  AWS_USE_PATH_STYLE_ENDPOINT: "true"
  AWS_ENDPOINT: "CHANGE_ME"
  AWS_PUBLIC_ENDPOINT: "CHANGE_ME"
  AWS_TTL: "604800"

  # SSO Keycloak
  KEYCLOAK_CLIENT_ID: "vlute.edu.vn"
  KEYCLOAK_CLIENT_SECRET: "CHANGE_ME"
  KEYCLOAK_BASE_URL: "https://sso.vlute.edu.vn/auth/"
  KEYCLOAK_REALM: "VLUTE"
  KEYCLOAK_REDIRECT_URI: "https://hoso-sinhvien.vlute.edu.vn/sso/callback"

  SENTRY_LARAVEL_DSN: "https://4a3b2a6182dcc9394cc5902c32031317@o4509499969372160.ingest.us.sentry.io/4509624810536960"
  SENTRY_TRACES_SAMPLE_RATE: "0.2"

  ITEM_PER_PAGE: "50"
  BAT_GHI_LOG: "true"
  BAT_KIEM_TRA_FUNCS: "true"
  GHI_LOG_HTTP_METHOD: "POST,PUT,PATCH,DELETE"

  DAOTAO_API_URL: "https://daotao.vlute.edu.vn/api/admin/tt-sinh-vien"
  DAOTAO_API_TOKEN: "CHANGE_ME"
  DAOTAO_API_COOKIE: ""

  # FrankenPHP / Octane
  OCTANE_SERVER: "frankenphp"
  SERVER_NAME: ":8000"
