APP_NAME="Hồ sơ sinh viên"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://hoso-sinhvien.local
LOG_LEVEL=debug

# Laravel 11 mặc định session/cache/queue đều là "database".
# database/migrations/ rỗng (schema quản lý ngoài Laravel) nên ghi rõ ở đây,
# đừng dựa vào default ngầm.
#   QUEUE_CONNECTION=database -> cần bảng jobs / failed_jobs trong DB
#   CACHE_STORE=file          -> đổi sang database nếu chạy nhiều pod và có bảng cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# S3 / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hoso-sinhvien-vlute-edu-vn
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
# Endpoint trình duyệt dùng để tải file; bỏ trống thì lấy theo AWS_ENDPOINT
AWS_PUBLIC_ENDPOINT=
# TTL của presigned URL (giây)
AWS_TTL=604800

# SSO Keycloak
KEYCLOAK_CLIENT_ID=vlute.edu.vn
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=https://sso.vlute.edu.vn/auth/
KEYCLOAK_REALM=Dev
KEYCLOAK_REDIRECT_URI="${APP_URL}/sso/callback"

# app/VLUTE.php: danh sách email super admin, ngăn cách bằng dấu phẩy
SUPER_ADMIN_EMAILS=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Fallback khi bảng cai_dat chưa có khoá tương ứng (App\VLUTE::getCaiDat)
DAOTAO_API_URL=https://daotao.vlute.edu.vn/api/admin/tt-sinh-vien
DAOTAO_API_TOKEN=

ITEM_PER_PAGE=50
VITE_API_BASE_URL="${APP_URL}/api"
